# ═══════════════════════════════════════════════════════════════════════════════
# RADIANCE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit real secrets.
# ═══════════════════════════════════════════════════════════════════════════════

# ── APPLICATION CORE ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SUPABASE (DATABASE, AUTH, STORAGE) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI MODEL PROVIDER CREDENTIALS (SERVER-SIDE ONLY) ──
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ── RATE LIMITING & CACHE (OPTIONAL UPSTASH REDIS) ──
# If omitted, Radiance falls back to an in-memory token bucket rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── SENTRY APPLICATION MONITORING & PERFORMANCE TRACING ──
# Public client DSN (safe for browser)
NEXT_PUBLIC_SENTRY_DSN=
# Server-side Sentry DSN (optional override)
SENTRY_DSN=
# Sentry Organization and Project (for build-time sourcemap uploads)
SENTRY_ORG=
SENTRY_PROJECT=
# Sentry Auth Token (used during CI/build only, NEVER expose to client)
SENTRY_AUTH_TOKEN=

# ── VERCEL ANALYTICS & SPEED INSIGHTS ──
# Automatically injected by Vercel deployment runtime. No manual values required in production.
# For local analytics debugging:
# VERCEL_ANALYTICS_ID=

# ── EXTERNAL UPTIME & HEALTH MONITORING (BETTER STACK) ──
# Monitored via HTTP probes targeting:
# Liveness probe:  GET /api/health
# Readiness probe: GET /api/health/ready
